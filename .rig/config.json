{
  "$schema": "https://raw.githubusercontent.com/agent-rig/rig/main/rig.schema.json",
  "project": {
    "name": "lilbox",
    "repo": "lilco-dev/lilbox"
  },
  "runtime": {
    "packageManager": "none"
  },
  "test": {
    "command": "cargo test",
    "requiresDatabase": false
  },
  "sourceScope": [
    "src"
  ],
  "vcs": {
    "defaultBranch": "main",
    "baseRef": "origin/main",
    "branchConvention": "{user}/{ticket}-{slug}",
    "protectedBranchMergeQueue": false
  },
  "tracker": {
    "provider": "github",
    "team": "lilco-dev",
    "board": {
      "owner": "lilco-dev",
      "projectNumber": 6,
      "statusField": "Status",
      "statusOptions": {
        "todo": "Todo",
        "inProgress": "In Progress",
        "inReview": "In Review",
        "done": "Done"
      },
      "closingKeyword": "Closes"
    },
    "labelMapFile": ".rig/label-mapping.md",
    "githubIntegration": true,
    "shapeLabels": {
      "epic": "epic",
      "sprint": "sprint"
    }
  },
  "review": {
    "patternsFile": ".rig/REVIEWER.md",
    "bot": "none",
    "maxRounds": 5
  },
  "agents": {
    "debugger": "rig-debugger",
    "reviewer": "rig-reviewer",
    "architect": "rig-architect",
    "qa": "rig-qa",
    "coder": "rig-coder"
  }
}
