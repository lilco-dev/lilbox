# lilbox config — copy to ~/.config/lilbox/config.toml
# Flat key = value configuration.

# Defaults applied to `lilbox new` when the matching flag is omitted.
image = "python"
port = 8000
cpus = 2
memory = "2G"
ttl = "8h"
idle_timeout = "20m"

# Caps — a `lilbox new` request above these is clamped down (with a warning).
max_cpus = 4
max_memory = "8G"

# Tailnet join is opt-in: `lilbox new` only attempts it when you pass
# --tailnet (or --tailnet-tag, or set auto = true below). OAuth (mint an
# ephemeral, tagged, 5-minute key per box) takes precedence over authKeyEnv (a
# static, pre-generated key); neither set skips the join. See README.md's
# "Tailnet ACLs" section for details.
[tailscale]
tag = "tag:lilbox-vm"
oauthClientId = "k123abc..."
oauthClientSecretEnv = "TS_OAUTH_CLIENT_SECRET"
# authKeyEnv = "TS_AUTHKEY"
# auto = true                  # imply --tailnet on every `lilbox new`

# Image booted by a `lilbox gateway` `new` when neither --image nor a template
# picks one (remote SSH provisioning). Sits between the template image and the
# global `image` default above, and only applies on the gateway path. See
# README.md's "Remote provisioning over SSH" section.
[gateway]
image = "python"
# listen = "0.0.0.0:2222"        # make a bare `lilbox gateway` an SSH server
# authorized_keys = "..."        # default: ~/.config/lilbox/gateway_authorized_keys
